<Window x:Class="RestoreWin10.SearchFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="True" Background="Transparent" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI"
        Deactivated="OnDeactivated" PreviewKeyDown="OnKey">
  <Window.Resources>
    <Style x:Key="ResultItem" TargetType="ListBoxItem">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- The box itself sits exactly over the taskbar's search slot (docked top or bottom from code). -->
    <Border x:Name="Box" DockPanel.Dock="Bottom" Height="40" Background="#FFF2F2F2">
      <Grid>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF222222"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"/>
        <TextBlock x:Name="Hint" Text="Type here to search" Foreground="#FF444444" FontSize="14"
                   VerticalAlignment="Center" Margin="44,0,0,0" IsHitTestVisible="False"/>
        <TextBox x:Name="Input" Background="Transparent" BorderThickness="0" Foreground="Black" CaretBrush="Black"
                 FontSize="14" VerticalContentAlignment="Center" Padding="0" Margin="44,0,12,0" TextChanged="OnTextChanged"/>
      </Grid>
    </Border>

    <!-- Results -->
    <Border x:Name="Pane" Background="{DynamicResource SearchPaneBg}" Padding="0,6">
      <StackPanel>
        <TextBlock x:Name="Header" Text="Apps" Foreground="{DynamicResource FgDim}" FontSize="12" Margin="14,4,0,4"/>
        <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Focusable="False"
                 ItemContainerStyle="{StaticResource ResultItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="OnResultClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Height="40" Margin="14,0,0,0">
                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Text="No results" Foreground="{DynamicResource FgFaint}" FontSize="12" Margin="14,4,0,6" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
