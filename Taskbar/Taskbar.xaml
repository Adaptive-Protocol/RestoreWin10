<Window x:Class="RestoreWin10.Taskbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RestoreWin10"
        Width="1200" Height="40" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" Background="Transparent" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI">
  <Window.Resources>
    <!-- Square, flat taskbar button (Start, Task View, tray, notification) -->
    <Style x:Key="TbButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Press}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    </Style>

    <DataTemplate x:Key="TaskTemplate">
      <!-- Windows 10's program button (measured from a Windows 10 screenshot): 40 wide, and a running program
           has a 2-px line under it, inset 5 each side; the active one's line runs the full width over a lighter button. -->
      <Border x:Name="TaskRoot" Width="40" Height="40" Background="Transparent" ToolTip="{Binding Name}"
              PreviewMouseLeftButtonDown="OnTaskDown" MouseLeftButtonUp="OnTaskClick" MouseRightButtonUp="OnTaskRight"
              MouseDown="OnTaskMiddle" MouseEnter="OnTaskEnter" MouseLeave="OnTaskLeave">
        <Grid>
          <Border x:Name="Hl" Background="Transparent"/>
          <Image Source="{Binding Icon}" Width="24" Height="24"/>
          <Rectangle x:Name="Ind" Height="2" Width="30" VerticalAlignment="Bottom" Fill="{DynamicResource Running}" Visibility="Collapsed"/>
          <!-- More than one window: a short faint piece after the line, the edge of the "stack" -->
          <Rectangle x:Name="Ind2" Height="2" Width="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                     Margin="34,0,0,0" Fill="{DynamicResource FgFaint}" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRunning}" Value="True">
          <Setter TargetName="TaskRoot" Property="ToolTipService.IsEnabled" Value="False"/>
          <Setter TargetName="Ind" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasMany}" Value="True">
          <Setter TargetName="Ind2" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDragging}" Value="True">
          <Setter TargetName="TaskRoot" Property="Opacity" Value="0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Hl" Property="Background" Value="{DynamicResource Selected}"/>
          <Setter TargetName="Ind" Property="Width" Value="40"/>
        </DataTrigger>
        <!-- Attention: Windows 10's orange, blinking at first, then steady until the window is activated -->
        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
          <Setter TargetName="Hl" Property="Background" Value="#66F7630C"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding NeedsAttention}" Value="True"/>
            <Condition Binding="{Binding Pulse}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="Hl" Property="Background" Value="#D9F7630C"/>
        </MultiDataTrigger>
        <Trigger SourceName="Hl" Property="IsMouseOver" Value="True">
          <Setter TargetName="Hl" Property="Background" Value="{DynamicResource Hover}"/>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root" Background="Transparent" PreviewMouseDown="OnRootDown" MouseMove="OnRootMove" MouseLeftButtonUp="OnRootUp"
        MouseRightButtonUp="OnBarRight">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Start -->
    <Button x:Name="StartBtn" Grid.Column="0" Style="{StaticResource TbButton}" Click="OnStart" MouseRightButtonUp="OnStartRight" ToolTip="Start">
      <!-- The Windows 10 logo: four panes seen in perspective (the left ones smaller), drawn on a 16-px grid -->
      <Path Width="16" Height="16" Fill="{DynamicResource Fg}"
            Data="M0,2.3 L7,1.3 L7,7 L0,7 Z M8,1.2 L16,0 L16,7 L8,7 Z M0,8 L7,8 L7,14.7 L0,13.8 Z M8,8 L16,8 L16,16 L8,14.8 Z"/>
    </Button>

    <!-- Search: just the glyph until clicked, then the slot widens into the search box -->
    <Border x:Name="SearchSlot" Grid.Column="1" Width="48" Background="Transparent" Cursor="Arrow" ToolTip="Search"
            MouseLeftButtonUp="OnSearchSlot" MouseEnter="OnSlotEnter" MouseLeave="OnSlotLeave">
      <Grid>
        <!-- Windows 10's search icon: a bold ring and handle, 22 px (measured from a Windows 10 screenshot) -->
        <Path x:Name="SearchIcon" Width="22" Height="22" Stroke="{DynamicResource Fg}" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0">
          <Path.Data>
            <GeometryGroup>
              <EllipseGeometry Center="13,9" RadiusX="7.5" RadiusY="7.5"/>
              <LineGeometry StartPoint="7.7,14.3" EndPoint="1.5,20.5"/>
            </GeometryGroup>
          </Path.Data>
        </Path>
        <TextBlock x:Name="SearchGlyph" Text="&#xE721;" Style="{StaticResource Glyph}" Foreground="#FF222222" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Margin="14,0,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="SearchText" Text="Type here to search" Foreground="#FF444444" FontSize="14" VerticalAlignment="Center"
                   Margin="44,0,12,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
      </Grid>
    </Border>

    <!-- Task View -->
    <Button x:Name="TaskViewBtn" Grid.Column="2" Style="{StaticResource TbButton}" Click="OnTaskView" ToolTip="Task View">
      <TextBlock Text="&#xE7C4;" Style="{StaticResource Glyph}"/>
    </Button>

    <!-- Pinned + running programs; the strip scrolls (arrows appear) when more than fit -->
    <Grid Grid.Column="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="ScrollLeft" Style="{StaticResource TbButton}" Width="18" Visibility="Collapsed" Click="OnScrollLeft">
        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="10"/>
      </Button>
      <ScrollViewer x:Name="TaskScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    ScrollChanged="OnTaskScrollChanged" PreviewMouseWheel="OnTaskWheel">
        <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource TaskTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><local:SlidePanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
      <Button x:Name="ScrollRight" Grid.Column="2" Style="{StaticResource TbButton}" Width="18" Visibility="Collapsed" Click="OnScrollRight">
        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="10"/>
      </Button>
    </Grid>

    <!-- Right side: quick-access glyphs, clock, notifications, show desktop -->
    <StackPanel Grid.Column="4" Orientation="Horizontal">
      <!-- Notification area (replace mode): "^" overflow flyout + icons pinned to the taskbar -->
      <Button x:Name="ChevronBtn" Style="{StaticResource TbButton}" Width="32" Click="OnChevron" ToolTip="Show hidden icons" Visibility="Collapsed">
        <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" FontSize="11"/>
      </Button>
      <ItemsControl x:Name="InlineTray">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="32" Height="40" Background="Transparent" ToolTip="{Binding Tooltip}"
                    MouseLeftButtonDown="OnTrayDown" MouseLeftButtonUp="OnTrayUp" MouseRightButtonUp="OnTrayRight">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger></Style.Triggers>
                </Style>
              </Border.Style>
              <Image Source="{Binding Icon}" Width="16" Height="16"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Battery: only on a PC that has one (Battery.Read); left of network and sound, as in Windows 10 -->
      <Button x:Name="BatteryBtn" Style="{StaticResource TbButton}" Width="32" Click="OnBattery" MouseRightButtonUp="OnBatteryMenu" Visibility="Collapsed">
        <TextBlock x:Name="BatteryGlyph" Style="{StaticResource Glyph}" FontSize="13"/>
      </Button>
      <Button x:Name="NetBtn" Style="{StaticResource TbButton}" Width="32" Click="OnNetwork" MouseRightButtonUp="OnNetworkMenu" ToolTip="Network">
        <TextBlock x:Name="NetGlyph" Text="&#xE839;" Style="{StaticResource Glyph}" FontSize="15"/>
      </Button>
      <Button x:Name="SoundBtn" Style="{StaticResource TbButton}" Width="32" Click="OnVolume" MouseRightButtonUp="OnSoundMenu" ToolTip="Sound">
        <TextBlock x:Name="SoundGlyph" Text="&#xE767;" Style="{StaticResource Glyph}" FontSize="15"/>
      </Button>
      <!-- As wide as its text plus 8 each side, like Windows 10's clock -->
      <Button x:Name="ClockBtn" Style="{StaticResource TbButton}" Width="Auto" Click="OnClock" MouseRightButtonUp="OnClockRight" ToolTip="Notifications and calendar">
        <StackPanel HorizontalAlignment="Center" Margin="8,0">
          <TextBlock x:Name="TimeText" Foreground="{DynamicResource Fg}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DateText" Foreground="{DynamicResource Fg}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource TbButton}" Width="48" Click="OnNotifications" ToolTip="Notifications">
        <TextBlock Text="&#xE91C;" Style="{StaticResource Glyph}"/>
      </Button>
      <Border Width="8" MouseLeftButtonUp="OnShowDesktop" ToolTip="Show desktop" Cursor="Arrow">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger></Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </StackPanel>
    <Canvas x:Name="DragLayer" Grid.ColumnSpan="5" IsHitTestVisible="False"/>
  </Grid>
</Window>
