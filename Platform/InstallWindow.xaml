<Window x:Class="RestoreWin10.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestoreWin10 Setup" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="White" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- The install window (a downloaded RestoreWin10.exe opened without arguments). It runs as the user; the one step that
       needs administrator rights is a separate, windowless run of the same file (Setup.cs). -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0078D4" Padding="22,18,22,16">
      <StackPanel>
        <TextBlock x:Name="Heading" Foreground="White" FontSize="20" FontWeight="Light" Text="Install RestoreWin10"/>
        <TextBlock x:Name="SubHeading" Foreground="#DDFFFFFF" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#F3F3F3" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PrimaryButton" MinWidth="104" Height="30" Margin="0,0,8,0" Padding="12,0" IsDefault="True" Click="OnPrimary">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="Shield" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="PrimaryText" Text="Install" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SecondaryButton" MinWidth="96" Height="30" Padding="12,0" IsCancel="True" Click="OnSecondary" Content="Cancel"/>
      </StackPanel>
    </Border>
    <Grid Margin="22,18,22,22">
      <StackPanel x:Name="ReadyPage">
        <TextBlock x:Name="ReadyText" TextWrapping="Wrap" LineHeight="19"/>
        <CheckBox x:Name="SignInBox" Margin="0,16,0,0" Content="Start RestoreWin10 when I sign in"/>
        <TextBlock x:Name="ReadyNote" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#5F5F5F" FontSize="12"/>
      </StackPanel>
      <StackPanel x:Name="BusyPage" Visibility="Collapsed">
        <TextBlock x:Name="BusyText" TextWrapping="Wrap" LineHeight="19"/>
        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,0"/>
      </StackPanel>
      <StackPanel x:Name="DonePage" Visibility="Collapsed">
        <TextBlock x:Name="DoneText" TextWrapping="Wrap" LineHeight="19"/>
        <CheckBox x:Name="StartNowBox" Margin="0,16,0,0" Content="Start RestoreWin10 now" IsChecked="True"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
